{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.siebensterne.invalid/ndc/v2/profile-1/schemas/ordering-profiles.schema.json",
  "title": "Canonical NDC v2 Profile 1 ordering profiles — version 1",
  "description": "Typed artifact-level record_order_profile and per-record ordering tagged unions. Both are closed tagged objects; a record carries exactly one mode. This file is the standalone typed definition matching manifest.schema.json and record-envelope.schema.json.",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "DecimalStringU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "SequencedArtifactProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sequence_domain_id",
        "sequence_epoch"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "sequenced"
        },
        "sequence_domain_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "sequence_epoch": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "description": "Sequenced artifact profile requires a non-empty sequence domain and epoch."
    },
    "ReferenceArtifactProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "reference"
        }
      },
      "description": "Reference artifact profile carries neither domain nor epoch."
    },
    "ArtifactRecordOrderProfile": {
      "oneOf": [
        {
          "$ref": "#/$defs/SequencedArtifactProfile"
        },
        {
          "$ref": "#/$defs/ReferenceArtifactProfile"
        }
      ],
      "description": "Closed kind set; tagged object, never a bare string."
    },
    "SequencedRecordOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sequence_domain_id",
        "sequence_epoch",
        "sequence_number"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "sequenced"
        },
        "sequence_domain_id": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "sequence_epoch": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "sequence_number": {
          "$ref": "#/$defs/DecimalStringU64"
        }
      }
    },
    "ReferenceRecordOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "object_id",
        "revision",
        "knowledge_time_ns",
        "assertion_id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "reference"
        },
        "object_id": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/DecimalStringU64"
        },
        "knowledge_time_ns": {
          "$ref": "#/$defs/DecimalStringU64"
        },
        "assertion_id": {
          "$ref": "#/$defs/Identifier"
        }
      }
    },
    "RecordOrdering": {
      "oneOf": [
        {
          "$ref": "#/$defs/SequencedRecordOrdering"
        },
        {
          "$ref": "#/$defs/ReferenceRecordOrdering"
        }
      ],
      "description": "Exactly one mode. Both key sets on one record fail strict validation. The key is byte-derived, never caller-supplied; see record-envelope.schema.json and semantic-constraints.md."
    }
  },
  "$ref": "#/$defs/ArtifactRecordOrderProfile"
}
