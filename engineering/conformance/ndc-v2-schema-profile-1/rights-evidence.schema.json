{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.siebensterne.invalid/ndc/v2/profile-1/schemas/rights-evidence.schema.json",
  "title": "Canonical NDC v2 Profile 1 typed source-rights evidence — version 1",
  "description": "Full typed source-rights evidence for the producer. Opaque reference strings are not sufficient. This evidence is separate from consumer authorization; a signature, receipt, capability claim or lineage chain grants no right. The separate consumer-use proposal is not an approved rights contract.",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "enum": [
          "UNKNOWN",
          "ALL",
          "null",
          "TBD"
        ]
      }
    },
    "DecimalStringU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "CountOrSize": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "$ref": "#/$defs/DecimalStringU64"
        }
      ]
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcInstantString": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{9}Z$"
    },
    "ProducerAction": {
      "type": "string",
      "enum": [
        "source_contact",
        "reference_data_retrieval",
        "historical_data_retrieval",
        "real_time_capture",
        "raw_storage",
        "normalization",
        "replay",
        "backup",
        "internal_analytics",
        "derived_data_creation",
        "display",
        "external_redistribution",
        "retention",
        "deletion"
      ]
    },
    "GrantingAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "evidence_reference"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evidence_reference": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "description": "The authority that granted the right, distinct from the publisher signing key and from the reviewer."
    },
    "ScopeDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "source_product_id",
        "venue_id",
        "segment_id",
        "dataset_id",
        "subject_state",
        "named_subjects",
        "data_time_begin_ns",
        "data_time_end_ns"
      ],
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_product_id": {
          "$ref": "#/$defs/Identifier"
        },
        "venue_id": {
          "$ref": "#/$defs/Identifier"
        },
        "segment_id": {
          "$ref": "#/$defs/Identifier"
        },
        "dataset_id": {
          "$ref": "#/$defs/Identifier"
        },
        "subject_state": {
          "type": "string",
          "enum": [
            "NAMED",
            "ALL",
            "NOT_APPLICABLE"
          ]
        },
        "named_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "data_time_begin_ns": {
          "$ref": "#/$defs/DecimalStringU64"
        },
        "data_time_end_ns": {
          "$ref": "#/$defs/DecimalStringU64"
        }
      }
    },
    "Validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "begin_ns",
        "end_ns",
        "clock_domain"
      ],
      "properties": {
        "begin_ns": {
          "$ref": "#/$defs/DecimalStringU64"
        },
        "end_ns": {
          "$ref": "#/$defs/DecimalStringU64"
        },
        "clock_domain": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "Delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "approved_endpoint_identities"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "approved_endpoint_identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_ns",
        "purge_rule"
      ],
      "properties": {
        "max_duration_ns": {
          "$ref": "#/$defs/CountOrSize"
        },
        "purge_rule": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "DocumentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "clause",
        "document_sha256",
        "contract_revision",
        "review_authority",
        "reviewed_on"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "clause": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "document_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "contract_revision": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "review_authority": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "reviewed_on": {
          "$ref": "#/$defs/UtcInstantString"
        }
      }
    },
    "DigestReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest_sha256"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "digest_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        }
      }
    },
    "ReviewedAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "usage_right",
        "usage_mode",
        "territory",
        "scope_assertions",
        "reviewer",
        "authority"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "usage_right": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "usage_mode": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "territory": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "scope_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "reviewer": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "authority": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "description": "Records review only; an attestation is not permission for an action absent from a grant."
    },
    "RegisteredAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "grant_id",
        "attestation"
      ],
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "grant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "attestation": {
          "$ref": "#/$defs/ReviewedAttestation"
        }
      }
    },
    "PermissionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "grant_revision",
        "granting_authority",
        "action",
        "object_class",
        "decision",
        "actor",
        "licensee",
        "recipient_class",
        "recipient_identity",
        "purpose",
        "scope",
        "validity",
        "delivery",
        "retention",
        "supporting_document_references",
        "contract_revision",
        "review_authority",
        "reviewed_on",
        "reviewed_attestation"
      ],
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/Identifier"
        },
        "grant_revision": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "granting_authority": {
          "$ref": "#/$defs/GrantingAuthority"
        },
        "action": {
          "$ref": "#/$defs/ProducerAction"
        },
        "object_class": {
          "$ref": "#/$defs/Identifier"
        },
        "decision": {
          "type": "string",
          "enum": [
            "PERMIT",
            "DENY"
          ]
        },
        "actor": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "licensee": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "recipient_class": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "recipient_identity": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "scope": {
          "$ref": "#/$defs/ScopeDeclaration"
        },
        "validity": {
          "$ref": "#/$defs/Validity"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "supporting_document_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DigestReference"
          }
        },
        "contract_revision": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "review_authority": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "reviewed_on": {
          "$ref": "#/$defs/UtcInstantString"
        },
        "reviewed_attestation": {
          "$ref": "#/$defs/ReviewedAttestation"
        }
      }
    },
    "RightsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission_grants",
        "document_references",
        "reviewed_attestations"
      ],
      "properties": {
        "permission_grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PermissionGrant"
          }
        },
        "document_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/DocumentReference"
          }
        },
        "reviewed_attestations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RegisteredAttestation"
          }
        }
      }
    }
  },
  "$ref": "#/$defs/RightsEvidence"
}
