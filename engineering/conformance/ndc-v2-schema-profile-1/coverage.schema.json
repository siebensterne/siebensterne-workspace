{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.siebensterne.invalid/ndc/v2/profile-1/schemas/coverage.schema.json",
  "title": "Canonical NDC v2 Profile 1 coverage evidence — version 1",
  "description": "Nine separately typed coverage dimensions. Denominator is required and non-zero; no PASS without declared universe, denominator identity, count basis, as-of instant and evidence reference. Counts are disjoint parts of one denominator; arithmetic and no-PASS rules are semantic constraints in semantic-constraints.md.",
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "DecimalStringU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "CountOrSize": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "$ref": "#/$defs/DecimalStringU64"
        }
      ]
    },
    "Gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gap_id",
        "gap_kind",
        "component",
        "count",
        "description"
      ],
      "properties": {
        "gap_id": {
          "$ref": "#/$defs/Identifier"
        },
        "gap_kind": {
          "type": "string",
          "enum": [
            "MISSING",
            "REJECTED",
            "OTHER"
          ]
        },
        "component": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count": {
          "$ref": "#/$defs/CountOrSize"
        },
        "description": {
          "$ref": "#/$defs/NonEmptyString"
        }
      },
      "description": "Typed gap; never silently filled, interpolated or implied as ALL."
    },
    "CoverageDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "universe_id",
        "denominator_identity",
        "count_basis",
        "numerator",
        "denominator",
        "missing_count",
        "rejected_count",
        "as_of_ns",
        "verdict",
        "evidence_reference",
        "gaps"
      ],
      "properties": {
        "dimension_id": {
          "type": "string",
          "enum": [
            "instrument_coverage",
            "listing_identity_coverage",
            "contract_coverage",
            "corporate_action_coverage",
            "session_time_coverage",
            "trade_event_coverage",
            "quote_depth_coverage",
            "mbo_coverage",
            "sequence_continuity"
          ]
        },
        "universe_id": {
          "$ref": "#/$defs/Identifier"
        },
        "denominator_identity": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "count_basis": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "numerator": {
          "$ref": "#/$defs/CountOrSize"
        },
        "denominator": {
          "$ref": "#/$defs/CountOrSize"
        },
        "missing_count": {
          "$ref": "#/$defs/CountOrSize"
        },
        "rejected_count": {
          "$ref": "#/$defs/CountOrSize"
        },
        "as_of_ns": {
          "$ref": "#/$defs/DecimalStringU64"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "evidence_reference": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          }
        }
      }
    },
    "CoverageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimensions"
      ],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/CoverageDimension"
          }
        }
      },
      "description": "Nine separate dimensions with independent universes, denominators and as-of instants."
    }
  },
  "$ref": "#/$defs/CoverageEvidence"
}
