    {
      "id": "predecessor-not-immediate",
      "current_revision": 3,
      "supersedes_revision": 1,
      "expected_rejection": "REJECT_SOURCE_LINEAGE",
      "rule": "The predecessor is immediate: chain traversal decrements by one from the current revision."
