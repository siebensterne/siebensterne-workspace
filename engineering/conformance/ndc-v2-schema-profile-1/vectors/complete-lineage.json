    {
      "id": "missing-predecessor-evidence",
      "condition": "supersedes is present but trusted predecessor evidence is unavailable outside the release",
      "expected_rejection": "REJECT_SOURCE_LINEAGE",
      "rule": "Trusted predecessor evidence resolves outside the release; chain walks fail on the first breach."
    },
    {
      "id": "event-level-lineage-not-merged",
      "condition": "an event-level correction carries its own knowledge time and revision in its payload",
      "expected": "NO_RELEASE_LEVEL_MERGE",
