    {
      "id": "predecessor-revision-regression",
      "current_revision": 2,
      "supersedes_revision": 2,
      "expected_rejection": "REJECT_SOURCE_LINEAGE",
      "rule": "The immediate predecessor revision is strictly less than the current revision."
    },
    {
      "id": "supersedes-self-reference",
      "release_id": "release-example",
      "supersedes_release_id": "release-example",
      "expected_rejection": "REJECT_SOURCE_LINEAGE",
      "rule": "Self-reference and a release supplying its own predecessor are rejected."
