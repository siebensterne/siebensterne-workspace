    {
      "id": "invalidated-at-time-wrong-precision",
      "invalidated_at_time": "2026-01-02T00:00:00.000000Z",
      "expected_rejection": "REJECT_SHAPE",
      "rule": "The canonical UTC string carries exactly nine fractional digits and the Z designator."
    },
    {
      "id": "invalidated-at-time-offset-form",
      "invalidated_at_time": "2026-01-02T00:00:00.000000000+00:00",
      "expected_rejection": "REJECT_SHAPE",
      "rule": "No offset form is admitted; neither Rust string representation is normative."
    },
    {
      "id": "supersedes-array-form",
      "supersedes": ["predecessor-relation-example"],
      "expected_rejection": "REJECT_SHAPE",
      "rule": "A multi-predecessor array is not modelled in Profile 1; one seven-member relation is required."
