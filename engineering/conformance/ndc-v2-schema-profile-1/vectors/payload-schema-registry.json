{
  "vector_set": "Canonical NDC v2 Profile 1 — per-event-type payload schema registry",
  "authority": "WS-NDC-2026-11-24-003 digest 417bd4e5e9904d21d2da5905b3ac68905d677f800526eeedcf25fab897ce2119 §12.2 and DP-24",
  "note": "Event types, schema ids and digests are arbitrary abstract values. No payload schema bytes are carried here.",
  "cases": [
    {
      "id": "versioned-registry-accept",
      "registry": {
        "schema_version": 1,
        "registry_id": "registry-example",
        "entries": [
          {"event_type": "event-type-example-a", "schema_id": "payload-schema-example-a", "schema_version": "1", "digest_sha256": "4444444444444444444444444444444444444444444444444444444444444444"},
          {"event_type": "event-type-example-b", "schema_id": "payload-schema-example-b", "schema_version": "2", "digest_sha256": "9999999999999999999999999999999999999999999999999999999999999999"}
        ]
      },
      "expected": "ACCEPT_REGISTRY",
      "rule": "Each entry declares an explicit event type, schema identity, schema version and registered digest."
    },
    {
      "id": "manifest-wide-scalar",
      "schema_versions_delta": {"payload_schema_version": "payload-1"},
      "expected_rejection": "REJECT_SHAPE",
      "rule": "A single manifest-wide scalar payload_schema_version is rejected."
    },
    {
      "id": "silent-positional-array",
      "schema_versions_delta": {"payload_schema_versions": ["1", "2"]},
      "expected_rejection": "REJECT_SHAPE",
      "rule": "A silent positional array without explicit event type, identity and digest is rejected."
    },
    {
      "id": "unregistered-event-type",
      "event_type": "event-type-example-c",
      "expected_rejection": "REJECT_PAYLOAD_SCHEMA",
      "rule": "An event type with no registered payload schema entry fails closed."
    },
    {
      "id": "duplicate-event-type-entry",
      "entries": [
        {"event_type": "event-type-example-a", "schema_id": "payload-schema-example-a", "schema_version": "1", "digest_sha256": "4444444444444444444444444444444444444444444444444444444444444444"},
        {"event_type": "event-type-example-a", "schema_id": "payload-schema-example-b", "schema_version": "2", "digest_sha256": "9999999999999999999999999999999999999999999999999999999999999999"}
      ],
      "expected_rejection": "REJECT_PAYLOAD_SCHEMA",
      "rule": "Event type values are unique; ambiguity fails closed."
    },
    {
      "id": "digest-mismatch",
      "entry": {"event_type": "event-type-example-a", "schema_id": "payload-schema-example-a", "schema_version": "1", "digest_sha256": "4444444444444444444444444444444444444444444444444444444444444444"},
      "condition": "the registered bytes of that payload schema version hash to a different value",
      "expected_rejection": "REJECT_PAYLOAD_SCHEMA",
      "rule": "The declared digest binds the exact registered payload schema bytes."
    },
    {
      "id": "envelope-version-mismatch",
      "manifest_envelope_version": "envelope-1",
      "record_envelope_schema_version": "envelope-2",
      "expected_rejection": "REJECT_SCHEMA_ENVELOPE",
      "rule": "Every record envelope declares the same envelope schema version as the manifest."
    }
  ]
}
