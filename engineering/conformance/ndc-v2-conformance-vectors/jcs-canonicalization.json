{
  "vector_set": "RFC 8785 JSON Canonicalization Scheme",
  "authority": "RFC 8785 section 3.2 and Appendix B",
  "cases": [
    {
      "id": "appendix-b-number-samples",
      "input": {"numbers": [333333333.33333329, 1E30, 4.50, 2e-3, 0.000000000000000000000000001]},
      "expected_canonical": "{\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27]}"
    },
    {
      "id": "utf16-member-order",
      "input": {"": "private-use-example", "𐀀": "supplementary-example"},
      "expected_canonical": "{\"𐀀\":\"supplementary-example\",\"\":\"private-use-example\"}"
    },
    {
      "id": "control-character-escaping",
      "input": {"text": "line\nbreak\ttab"},
      "expected_canonical": "{\"text\":\"line\\nbreak\\ttab\"}"
    }
  ],
  "note": "Abstract strings and official number samples only. No market observation."
}
